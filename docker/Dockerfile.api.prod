# Multi-stage production build for the control-plane API (apps/api).
#
# Build args:
#   APP_WORKSPACE - npm workspace name, e.g. @toggleflow/api
#   APP_PATH      - path from the monorepo root, e.g. apps/api
#
# BOTH stages are glibc (Debian), not alpine: `miniflare` is a RUNTIME dependency
# of apps/api and boots workerd when KV_MODE=miniflare. Cloudflare's workerd
# binary is glibc-linked and has no musl build, so on alpine `npm ci` cannot even
# resolve a platform package for it.

ARG APP_WORKSPACE=@toggleflow/api
ARG APP_PATH=apps/api

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:24-bookworm-slim AS builder

# Re-declare the global ARGs - Docker ARGs do not cross stage boundaries.
ARG APP_WORKSPACE
ARG APP_PATH

WORKDIR /app

# Manifests + lockfile + every workspace package.json first, for layer caching.
COPY package.json package-lock.json ./
COPY apps/api/package.json         ./apps/api/
COPY apps/dashboard/package.json   ./apps/dashboard/
COPY apps/edge-worker/package.json ./apps/edge-worker/
COPY packages/engine/package.json  ./packages/engine/
COPY packages/sdk-js/package.json  ./packages/sdk-js/

RUN npm ci --loglevel=error --no-audit --no-fund

# tsconfig.base.json is extended by every workspace tsconfig - tsup/tsc hard-fail
# (TS5083) without it in the build context.
COPY tsconfig.base.json turbo.json ./
COPY packages/     ./packages/
COPY ${APP_PATH}/  ./${APP_PATH}/

# turbo.json's build task has dependsOn ["^build"], so this builds
# packages/engine first - apps/api imports @toggleflow/engine, which resolves to
# dist/, which is .dockerignored and therefore absent from the build context.
RUN npx turbo run build --filter=${APP_WORKSPACE}

# apps/api/tsup.config.ts does NOT bundle runtime deps (fastify, drizzle-orm,
# postgres, jose, miniflare), so the runtime stage needs real node_modules.
# Prune dev deps here rather than reinstalling in the runtime stage.
RUN npm prune --omit=dev

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM node:24-bookworm-slim AS runtime

# Re-declare ARGs so they're available in this stage (they don't cross stages).
ARG APP_PATH=apps/api

ENV NODE_ENV=production

WORKDIR /app

# node_modules/@toggleflow/engine is an npm-workspaces symlink into
# ../../packages/engine, so packages/engine must be copied alongside node_modules
# or the symlink dangles.
COPY --from=builder --chown=node:node /app/node_modules             ./node_modules
COPY --from=builder --chown=node:node /app/packages/engine          ./packages/engine
COPY --from=builder --chown=node:node /app/${APP_PATH}/package.json ./apps/api/
COPY --from=builder --chown=node:node /app/${APP_PATH}/dist         ./apps/api/dist
# Committed SQL migrations + meta journal. dist/scripts/migrate.js resolves this
# folder from its own module URL, so the one-shot migrate service can reuse this
# image - drizzle-kit is a devDependency and was pruned above.
COPY --from=builder --chown=node:node /app/${APP_PATH}/drizzle      ./apps/api/drizzle

USER node
EXPOSE 4000
WORKDIR /app/apps/api

CMD ["node", "dist/index.js"]
