{
  "description": "Targeting: segment OR at the rule level, condition AND within a rule, first matching rule wins, unknown segment references never match, missing attributes match no operator.",
  "snapshot": {
    "schemaVersion": 1,
    "projectId": "proj-demo",
    "environmentId": "env-prod",
    "environmentKey": "prod",
    "version": 12,
    "publishedAt": "2026-07-27T12:00:00.000Z",
    "segments": {
      "beta-users": {
        "conditions": [{ "attribute": "plan", "operator": "in", "values": ["pro", "team"] }]
      },
      "eu": { "conditions": [{ "attribute": "region", "operator": "eq", "value": "eu" }] }
    },
    "tools": {
      "tool.beta-only": {
        "enabled": true,
        "rolloutPercent": null,
        "targetingRules": [
          { "segments": ["beta-users"], "conditions": [], "enabled": true },
          { "segments": [], "conditions": [], "enabled": false }
        ],
        "config": null
      },
      "tool.eu-disabled": {
        "enabled": true,
        "rolloutPercent": null,
        "targetingRules": [{ "segments": ["eu"], "conditions": [], "enabled": false }],
        "config": null
      },
      "tool.first-match-wins": {
        "enabled": true,
        "rolloutPercent": null,
        "targetingRules": [
          {
            "segments": [],
            "conditions": [{ "attribute": "plan", "operator": "eq", "value": "pro" }],
            "enabled": false
          },
          { "segments": ["beta-users"], "conditions": [], "enabled": true }
        ],
        "config": null
      },
      "tool.and-conditions": {
        "enabled": true,
        "rolloutPercent": 0,
        "targetingRules": [
          {
            "segments": [],
            "conditions": [
              { "attribute": "plan", "operator": "eq", "value": "pro" },
              { "attribute": "region", "operator": "eq", "value": "us" }
            ],
            "enabled": true
          }
        ],
        "config": null
      },
      "tool.unknown-segment": {
        "enabled": true,
        "rolloutPercent": 0,
        "targetingRules": [{ "segments": ["ghost"], "conditions": [], "enabled": true }],
        "config": null
      },
      "tool.missing-attr": {
        "enabled": true,
        "rolloutPercent": null,
        "targetingRules": [
          {
            "segments": [],
            "conditions": [{ "attribute": "region", "operator": "neq", "value": "eu" }],
            "enabled": false
          }
        ],
        "config": null
      },
      "tool.numeric": {
        "enabled": true,
        "rolloutPercent": 0,
        "targetingRules": [
          {
            "segments": [],
            "conditions": [{ "attribute": "seats", "operator": "gte", "value": 10 }],
            "enabled": true
          }
        ],
        "config": null
      }
    }
  },
  "cases": [
    {
      "name": "user in the beta-users segment gets the tool",
      "toolKey": "tool.beta-only",
      "context": { "key": "alice", "attributes": { "plan": "pro" } },
      "expected": {
        "key": "tool.beta-only",
        "enabled": true,
        "reason": "targeting",
        "config": null,
        "fallback": null
      }
    },
    {
      "name": "user outside the segment hits the catch-all off rule",
      "toolKey": "tool.beta-only",
      "context": { "key": "bob", "attributes": { "plan": "free" } },
      "expected": {
        "key": "tool.beta-only",
        "enabled": false,
        "reason": "targeting",
        "config": null,
        "fallback": null
      }
    },
    {
      "name": "segment rule disables the tool for eu users",
      "toolKey": "tool.eu-disabled",
      "context": { "key": "carol", "attributes": { "region": "eu" } },
      "expected": {
        "key": "tool.eu-disabled",
        "enabled": false,
        "reason": "targeting",
        "config": null,
        "fallback": null
      }
    },
    {
      "name": "non-eu users fall through to the default (on)",
      "toolKey": "tool.eu-disabled",
      "context": { "key": "dave", "attributes": { "region": "us" } },
      "expected": {
        "key": "tool.eu-disabled",
        "enabled": true,
        "reason": "default",
        "config": null,
        "fallback": null
      }
    },
    {
      "name": "first matching rule wins even when a later rule would enable",
      "toolKey": "tool.first-match-wins",
      "context": { "key": "alice", "attributes": { "plan": "pro" } },
      "expected": {
        "key": "tool.first-match-wins",
        "enabled": false,
        "reason": "targeting",
        "config": null,
        "fallback": null
      }
    },
    {
      "name": "all inline conditions must match (AND) — full match enables",
      "toolKey": "tool.and-conditions",
      "context": { "key": "erin", "attributes": { "plan": "pro", "region": "us" } },
      "expected": {
        "key": "tool.and-conditions",
        "enabled": true,
        "reason": "targeting",
        "config": null,
        "fallback": null
      }
    },
    {
      "name": "partial condition match falls through to the 0% rollout (off)",
      "toolKey": "tool.and-conditions",
      "context": { "key": "erin", "attributes": { "plan": "pro", "region": "eu" } },
      "expected": {
        "key": "tool.and-conditions",
        "enabled": false,
        "reason": "rollout",
        "config": null,
        "fallback": null
      }
    },
    {
      "name": "rule referencing an unknown segment never matches",
      "toolKey": "tool.unknown-segment",
      "context": { "key": "alice", "attributes": { "plan": "pro" } },
      "expected": {
        "key": "tool.unknown-segment",
        "enabled": false,
        "reason": "rollout",
        "config": null,
        "fallback": null
      }
    },
    {
      "name": "missing attribute matches no operator, not even neq",
      "toolKey": "tool.missing-attr",
      "context": { "key": "frank", "attributes": {} },
      "expected": {
        "key": "tool.missing-attr",
        "enabled": true,
        "reason": "default",
        "config": null,
        "fallback": null
      }
    },
    {
      "name": "present attribute satisfying neq triggers the rule",
      "toolKey": "tool.missing-attr",
      "context": { "key": "frank", "attributes": { "region": "us" } },
      "expected": {
        "key": "tool.missing-attr",
        "enabled": false,
        "reason": "targeting",
        "config": null,
        "fallback": null
      }
    },
    {
      "name": "numeric gte matches numbers",
      "toolKey": "tool.numeric",
      "context": { "key": "grace", "attributes": { "seats": 12 } },
      "expected": {
        "key": "tool.numeric",
        "enabled": true,
        "reason": "targeting",
        "config": null,
        "fallback": null
      }
    },
    {
      "name": "numeric operators are type-strict — a numeric string does not match",
      "toolKey": "tool.numeric",
      "context": { "key": "grace", "attributes": { "seats": "12" } },
      "expected": {
        "key": "tool.numeric",
        "enabled": false,
        "reason": "rollout",
        "config": null,
        "fallback": null
      }
    }
  ]
}
